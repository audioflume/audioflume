# Copy this file to .env.local and fill in your values.
# Never commit .env.local to the repository.

# ── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Admin access ──────────────────────────────────────────────
# Comma-separated list of emails that have admin access.
# Used by both the client-side admin page check (NEXT_PUBLIC_)
# and the server-side API route check.
# Preferred alternative: set publicMetadata: { role: "admin" }
# on your user in the Clerk dashboard — then these vars are not needed.
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com,other@example.com
ADMIN_EMAILS=you@example.com,other@example.com

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Airtable ──────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
